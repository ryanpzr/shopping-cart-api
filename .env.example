# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# JWT_SECRET is required: the API refuses to start without it.
# Use a long random value, e.g. generated with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Activity log (optional). docker-compose already sets these for the containers, where
# the services reach each other as mongo:27017 and kafka:9092 (no ports are published).
# To run the API or the consumer on your machine, publish those ports and point these values at them.
#
# MongoDB holds the audit history read by GET /admin/users/:id/activity.
# Without MONGO_URI that endpoint answers 503 and everything else works.
#MONGO_URI=mongodb://localhost:27017
#MONGO_DB=activity_log
#
# Used only by cmd/activity-consumer (Kafka -> MongoDB):
#KAFKA_BROKERS=localhost:9092
#KAFKA_TOPIC=activity-log.events
#KAFKA_DLQ_TOPIC=activity-log.events.dlq
#KAFKA_GROUP=activity-log-writer
